# Salin ke supabase/.env.local lalu isi nilainya.
# File .env.local TIDAK boleh di-commit (lihat .gitignore).

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Hanya untuk script admin/sync di mesin lokal — jangan pernah dikirim ke aplikasi.
SUPABASE_SECRET_KEY=<secret-key>
SUPABASE_DB_URL=postgresql://postgres.<project-ref>@<pooler-host>:5432/postgres
